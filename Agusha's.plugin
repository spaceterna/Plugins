MIN_ID = -1900000000
MAX_ID = -1800000000


def local_id(n):
    try:
        return MIN_ID <= int(n) < MAX_ID
    except Exception:
        return False


def field(obj, name, default=None):
    if obj is None:
        return default
    try:
        return getattr(obj, name)
    except Exception:
        try:
            cls = obj.getClass()
        except Exception:
            return default
        while cls:
            try:
                f = cls.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                cls = cls.getSuperclass()
        return default


def peer(uid):
    p = TLRPC.TL_peerUser() if uid > 0 else TLRPC.TL_peerChannel()
    if uid > 0:
        p.user_id = uid
    else:
        p.channel_id = -uid
    return p


def encode(gift):
    s = SerializedData()
    try:
        gift.serializeToStream(s)
        return str(Base64.encodeToString(s.toByteArray(), Base64.NO_WRAP))
    finally:
        s.cleanup()


def decode(data):
    s = SerializedData(Base64.decode(data, Base64.DEFAULT))
    try:
        return TL_stars.StarGift.TLdeserialize(s, s.readInt32(True), True)
    finally:
        s.cleanup()


def source_slug(gift):
    slug = str(field(gift, "slug", "") or "")
    if re.fullmatch(r"[A-Za-z][A-Za-z0-9]*-[1-9][0-9]*", slug) and not slug.lower().startswith(("localgift-", "spaceterna-")):
        return slug
    return ""


def parsed_nft_link(value):
    value = str(value or "").strip()
    if len(value) > 2048:
        raise ValueError("Ссылка слишком длинная")
    if re.fullmatch(r"[A-Za-z][A-Za-z0-9]*-[1-9][0-9]*", value):
        value = "https://t.me/nft/" + value
    elif value.startswith("t.me/"):
        value = "https://" + value
    u = urllib.parse.urlsplit(value)
    if u.scheme not in ("https", "http") or u.hostname not in ("t.me", "telegram.me"):
        raise ValueError("Нужна NFT-ссылка t.me/nft/…")
    slug = u.path.removeprefix("/nft/").rstrip("/") if u.path.startswith("/nft/") else ""
    if slug.startswith("spaceterna-"):
        slug = slug[len("spaceterna-"):]
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*-[1-9][0-9]*", slug):
        raise ValueError("Некорректный NFT")
    return slug


def trade_allowed(row, uid):
    return (
        row.get("owner") == uid
        and row.get("state", "owned") == "owned"
        and not row.get("custom", True)
        and bool(row.get("source_slug"))
    )


def row_active(row):
    return row.get("state", "owned") != "deleted"


class Run(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        self.fn()


class Hook(MethodHook):
    def __init__(self, plugin, before=None, after=None):
        self.p = plugin
        self.before = before
        self.after = after

    def before_hooked_method(self, param):
        if self.before:
            try:
                self.before(param)
            except Exception as e:
                self.p.error(e)
                if isinstance(e, ValueError):
                    self.p.info(str(e))

    def after_hooked_method(self, param):
        if self.after:
            try:
                self.after(param)
            except Exception as e:
                self.p.error(e)


class LocalGifts(BasePlugin):


    def on_plugin_load(self):
        self.lock = threading.RLock()
        self.status = ["Fake NFT " + __version__]
        self.errors = []
        self.alive = True
        self.ready = False
        self.cache = {}
        self.lists = []

        self.hook("org.telegram.ui.Stars.StarsController", "getProfileGiftsList", after=self.got_list)
        self.hook("org.telegram.ui.Stars.StarsController$GiftsList", "load", before=self.before_load)
        self.hook("org.telegram.messenger.NotificationCenter", "postNotificationName", before=self.notification)

        self.hook("org.telegram.messenger.MessagesController", "getUserFull", after=self.user_full)
        self.hook("org.telegram.messenger.MessagesController", "getUser", after=self.fake_profile_user)
        self.hook("org.telegram.messenger.UserConfig", "getCurrentUser", after=self.fake_profile_user)
        self.hook("org.telegram.ui.ProfileActivity", "updateProfileData", after=self.fake_profile_fragment)

        normal = self.hook("org.telegram.ui.Stars.StarsController", "buyStarGift", before=self.buy_normal)
        resale = self.hook("org.telegram.ui.Stars.StarGiftSheet", "onBuyPressed", before=self.buy_unique)
        self.hook("org.telegram.ui.Stars.StarsController", "buyResellingGift", before=self.buy_resale)
        self.hook("org.telegram.ui.Stars.StarGiftSheet", "doTransfer", before=self.transfer_hook)
        self.hook("org.telegram.ui.Stars.StarGiftSheet", "openTransfer", before=self.open_transfer)
        self.hook("org.telegram.ui.Stars.StarsController$GiftsList", "getTotalCount", after=self.total)
        self.hook("org.telegram.ui.ChatActivity", "didReceivedNotification", before=self.chat_notification)

        guard = self.hook("org.telegram.tgnet.ConnectionsManager", "sendRequest", before=self.network_guard)
        self.ready = bool(normal and resale and guard)
        if not self.ready:
            self.set_setting("simulate", False)

        self.add_on_send_message_hook()


    def hook(self, cls_name, name, before=None, after=None):
            count = 0
            try:
                cls = find_class(cls_name)
                if cls is None:
                    raise RuntimeError("Класс не найден: " + cls_name)
                # SDK versions may return either java.lang.Class or a Chaquopy
                # Python Java-type wrapper. Only the latter needs getClass().
                if isinstance(cls, type):
                    cls = cls.getClass()
                elif not callable(getattr(cls, "getDeclaredMethods", None)):
                    cls = cls.getClass()
                for m in cls.getDeclaredMethods():
                    if str(m.getName()) != name:
                        continue
                    try:
                        m.setAccessible(True)
                        handle = self.hook_method(m, Hook(self, before, after))
                        if handle is None:
                            raise RuntimeError("Движок не вернул дескриптор перехвата")
                        count += 1
                    except Exception as e:
                        self.errors.append(cls_name + "." + name + ": " + str(e)[:250])
            except Exception as e:
                self.errors.append(cls_name + "." + name + ": " + str(e)[:250])
            self.status.append(name + ": " + str(count))
            return count

    def error(self, e):
            text = str(e)[:350]
            if text not in self.errors:
                self.errors.append(text)
                self.errors = self.errors[-12:]
            self.log("Fake NFT: " + text)

    def info(self, text):
            run_on_ui_thread(lambda: BulletinHelper.show_info(text) if self.alive else None)

    def account(self):
            return int(UserConfig.selectedAccount)

    def uid(self, a):
            return int(UserConfig.getInstance(a).getClientUserId())

    def key(self, a):
            return "store_v1_" + str(self.uid(a))

    def store(self, a):
        key = self.key(a)
        if key not in self.cache:
            raw = self.get_setting(key, "")
            try:
                db = json.loads(raw) if raw else {"next": MIN_ID, "gifts": [], "events": [], "consumed": {}}
                if not isinstance(db, dict) or not isinstance(db.get("gifts"), list):
                    raise ValueError("Некорректное хранилище")
                db.setdefault("next", MIN_ID)
                db.setdefault("events", [])
                db.setdefault("consumed", {})
                for row in db["gifts"]:
                    row.setdefault("public_id", "FN-" + uuid.uuid4().hex[:16].upper())
                    row.setdefault("state", "owned" if row.get("owner") == self.uid(a) else "transferred")
                    row.setdefault("source_slug", "")
                    row.setdefault("custom", not bool(row.get("source_slug")))
                    row.setdefault("hidden", False)
                    row.setdefault("replace", 0)
                    row.setdefault("price", 0)
                self.cache[key] = db
            except Exception:
                raise ValueError("Хранилище Fake NFT повреждено")
        return self.cache[key]


    def save(self, a):
            self.set_setting(self.key(a), json.dumps(self.store(a), ensure_ascii=False))

    def next_id(self, db):
            n = int(db["next"])
            if n >= MAX_ID:
                raise ValueError("Исчерпан диапазон локальных ID")
            db["next"] = n + 1
            return n

    def mode(self):
            return self.ready and bool(self.get_setting("simulate", False))

    def mode_changed(self, value):
            if value and not self.ready:
                self.set_setting("simulate", False, reload_settings=True)
                self.info("Режим недоступен: открой диагностику совместимости.")
            else:
                if not value:
                    for a, li in list(self.market_lists):
                        try:
                            li.reload()
                        except Exception as e:
                            self.error(e)
                self.info("Локальная имитация включена" if value else "Локальная имитация выключена")

    def _version_tuple(self, value):
            parts = re.findall(r"\d+", str(value or ""))
            return tuple(int(x) for x in parts[:4]) or (0,)

    def _github_raw_url(self):
            repo = "spaceterna/Plugins"
            path = "Agusha\'s.plugin"
            if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo):
                raise ValueError("Укажи GitHub репозиторий в формате owner/repo")
            if not path or ".." in path:
                raise ValueError("Некорректный путь к .plugin")
            return "https://raw.githubusercontent.com/" + repo + "/main/" + urllib.parse.quote(path, safe="/")

    def _download_update_source(self):
            url = self._github_raw_url()
            req = urllib.request.Request(
                url,
                headers={
                    "User-Agent": "Agusha-Extera/" + __version__,
                    "Accept": "text/plain,*/*",
                    "Cache-Control": "no-cache",
                },
            )
            with urllib.request.urlopen(req, timeout=20) as response:
                raw = response.read()
            if len(raw) < 500 or len(raw) > 5 * 1024 * 1024:
                raise ValueError("GitHub вернул некорректный файл")
            source = raw.decode("utf-8-sig")
            if '__id__ = "agusha"' not in source and "__id__='agusha'" not in source:
                raise ValueError("Это не плагин Agusha")
            match = re.search(r'^__version__\s*=\s*["\']([^"\']+)["\']', source, re.M)
            if not match:
                raise ValueError("В обновлении не найдена __version__")
            compile(source, "<github-update>", "exec")
            return source, match.group(1), url

    def check_update(self, view=None):
            self.info("Проверяю обновление…")
            def work():
                try:
                    source, remote_version, url = self._download_update_source()
                    newer = self._version_tuple(remote_version) > self._version_tuple(__version__)
                    def show():
                        if newer:
                            self.dialog(
                                "Доступно обновление",
                                "Текущая версия: " + __version__ + "\nНовая версия: " + remote_version,
                                items=["Обновить", "Закрыть"],
                                action=lambda i: self.install_update() if i == 0 else None,
                            )
                        elif self._version_tuple(remote_version) == self._version_tuple(__version__):
                            self.dialog("Обновления", "Установлена актуальная версия: " + __version__)
                        else:
                            self.dialog(
                                "Обновления",
                                "На GitHub версия " + remote_version +
                                ", а установлена " + __version__ + ". Обновление не требуется."
                            )
                    run_on_ui_thread(show)
                except Exception as e:
                    self.error(e)
                    self.info("Ошибка проверки: " + str(e))
            threading.Thread(target=work, daemon=True).start()

    def install_update(self, view=None):
            self.info("Скачиваю обновление…")
            def work():
                try:
                    source, remote_version, url = self._download_update_source()
                    if self._version_tuple(remote_version) < self._version_tuple(__version__):
                        raise ValueError("На GitHub находится более старая версия " + remote_version)

                    current_path = globals().get("__file__")
                    if not current_path:
                        raise ValueError("ExteraGram не сообщил путь текущего плагина")
                    current_path = os.path.abspath(str(current_path))
                    if not os.path.isfile(current_path):
                        raise ValueError("Не найден текущий файл плагина")

                    temp_path = current_path + ".update"
                    backup_path = current_path + ".bak"

                    with open(temp_path, "w", encoding="utf-8", newline="\n") as f:
                        f.write(source)
                        f.flush()
                        try:
                            os.fsync(f.fileno())
                        except Exception:
                            pass

                    # Backup current working plugin before replacement.
                    try:
                        if os.path.exists(backup_path):
                            os.remove(backup_path)
                        with open(current_path, "rb") as src_f, open(backup_path, "wb") as bak_f:
                            bak_f.write(src_f.read())
                    except Exception:
                        pass

                    os.replace(temp_path, current_path)
                    self.info("Обновлено до " + remote_version + ". Перезапусти ExteraGram.")
                except Exception as e:
                    self.error(e)
                    self.info("Ошибка обновления: " + str(e))
            threading.Thread(target=work, daemon=True).start()

    def open_username_chat(self, a, username):
            username = str(username or "").strip().lstrip("@")
            def opened(uid):
                try:
                    Chat = jclass("org.telegram.ui.ChatActivity")
                    f = get_last_fragment()
                    if f is None:
                        return
                    chat = Chat.of(uid)
                    f.presentFragment(chat)
                except Exception as e:
                    self.error(e)
                    self.info("Не удалось открыть чат @" + username)
            self.resolve(a, username, opened)

    def create_settings(self):
        a = self.account()
        return [
            Header(text="Fake NFT"),
            Switch(
                key="simulate",
                text="Fake NFT",
                default=False,
                on_change=self.mode_changed,
                subtext="Локально перехватывает покупку и передачу фейковых подарков",
            ),
            Text(text="Выдать по ссылке", on_click=lambda v: self.url_dialog(a)),

            Header(text="Fake Profile"),
            Text(text="Number", on_click=lambda v: self.fake_number_dialog(a)),
            Text(text="Username", on_click=lambda v: self.fake_username_menu(a)),

            Header(text="Обновления · @agushka"),
            Text(
                text="Проверить обновление",
                subtext="Текущая версия: " + __version__,
                on_click=self.check_update,
            ),
            Text(
                text="Обновить",
                subtext="GitHub: spaceterna/Plugins",
                on_click=self.install_update,
            ),
            Text(
                text="@agushka",
                subtext="Разработчик · открыть чат",
                on_click=lambda v: self.open_username_chat(a, "agushka"),
            ),
        ]


    def pages(self, title, labels, action, page=0):
            size = 15
            start = page * size
            batch = labels[start:start + size]
            if not batch:
                self.info("Список пуст")
                return
            items = [x if len(x) <= 48 else x[:45] + "…" for x in batch]
            back = len(items) if page > 0 else -1
            if back >= 0:
                items.append("← Назад")
            forward = len(items) if start + size < len(labels) else -1
            if forward >= 0:
                items.append("Далее →")
            def choose(i):
                if i == back:
                    self.pages(title, labels, action, page - 1)
                elif i == forward:
                    self.pages(title, labels, action, page + 1)
                else:
                    action(start + i)
            self.dialog(title, items=items, action=choose)

    def recipient(self, a, callback):
            self.form("Получатель", [("@username или ID", "")], lambda v: self.resolve(a, v[0], callback))

    def resolve(self, a, value, callback):
            value = value.strip()
            if value.isdigit():
                uid = int(value)
                if not 0 < uid < 2**63:
                    raise ValueError("Неверный ID")
                self.dialog("Получатель " + str(uid), items=["Подтвердить", "Отмена"],
                            action=lambda i: callback(uid) if i == 0 else None)
                return
            username = re.sub(r"^(?:https?://)?t\.me/", "", value).strip("/@")
            if not re.fullmatch(r"[A-Za-z0-9_]{1,32}", username):
                raise ValueError("Введи @username или числовой ID")
            req = TLRPC.TL_contacts_resolveUsername()
            req.username = username
            def received(res, err):
                if not self.alive:
                    return
                uid = int(field(field(res, "peer"), "user_id", 0))
                if err or uid <= 0:
                    self.info("Пользователь не найден")
                    return
                mc = jclass("org.telegram.messenger.MessagesController").getInstance(a)
                mc.putUsers(res.users, False)
                user = mc.getUser(uid)
                name = " ".join(str(field(user, x, "") or "") for x in ("first_name", "last_name")).strip()
                run_on_ui_thread(lambda: self.dialog(name or username,
                    items=["Передать / выдать @" + username, "Отмена"],
                    action=lambda i: callback(uid) if i == 0 else None))
            send_request(req, received, account=a)
            self.info("Ищу @" + username)

    def dialog(self, title, message="", items=None, action=None):
            f = get_last_fragment()
            if not f or not f.getParentActivity():
                return
            b = AlertDialogBuilder(f.getParentActivity())
            b.set_title(title[:64])
            if items is None:
                b.set_message(message)
                b.set_positive_button("ОК", lambda d, w: d.dismiss())
            else:
                def click(d, i):
                    d.dismiss()
                    try:
                        action(int(i))
                    except Exception as e:
                        self.error(e)
                        self.info(str(e))
                b.set_items(items, click)
                b.set_negative_button("Закрыть", lambda d, w: d.dismiss())
            b.show()

    def form(self, title, fields, callback):
            f = get_last_fragment()
            if not f or not f.getParentActivity():
                return
            activity = f.getParentActivity()
            layout = LinearLayout(activity)
            layout.setOrientation(1)
            from org.telegram.messenger import AndroidUtilities
            Theme = jclass("org.telegram.ui.ActionBar.Theme")
            layout.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(8), AndroidUtilities.dp(20), AndroidUtilities.dp(8))
            inputs = []
            for hint, value in fields:
                caption = TextView(activity)
                caption.setText(hint)
                caption.setTextSize(13)
                caption.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                layout.addView(caption)
                view = EditText(activity)
                view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
                view.setTextSize(16)
                view.setHint(hint)
                view.setSingleLine(True)
                if hint == "Ключ доступа":
                    view.setInputType(129)
                view.setText(str(value))
                layout.addView(view)
                inputs.append(view)
            scroll = ScrollView(activity)
            scroll.addView(layout)
            b = AlertDialogBuilder(activity)
            b.set_title(title[:64])
            b.set_view(scroll)
            def submit(d, w):
                try:
                    callback([str(v.getText()).strip() for v in inputs])
                    d.dismiss()
                except Exception as e:
                    self.error(e)
                    self.info(str(e))
            b.set_positive_button("Готово", submit)
            b.set_negative_button("Отмена", lambda d, w: d.dismiss())
            b.show()

    def url_dialog(self, a=None):
            a = self.account() if a is None else a
            self.form("Выдать / открыть NFT", [("Ссылка t.me/nft/…", "")], lambda v: self.load_link(a, v[0]))

    def load_link(self, a, value):
        slug = parsed_nft_link(value)
        req = TL_stars.getUniqueStarGift()
        req.slug = slug

        def got(res, error):
            if not self.alive:
                return
            gift = field(res, "gift") if res is not None else None
            if error or gift is None:
                self.info("Карточка недоступна в Telegram")
                return
            data = encode(gift)

            def show():
                self.dialog(
                    self.label(decode(data)),
                    items=["Выдать себе", "Выдать получателю", "Отмена"],
                    action=lambda i:
                        self.add(a, decode(data), self.uid(a), "purchase") if i == 0 else
                        self.recipient(a, lambda uid: self.add(a, decode(data), uid, "purchase")) if i == 1 else None,
                )
            run_on_ui_thread(show)

        send_request(req, got, account=a)
        self.info("Загрузка карточки…")


    def label(self, gift):
            title = str(field(gift, "title", "") or "Подарок")
            num = int(field(gift, "num", 0))
            if num:
                return title + " #" + str(num)
            return title + " · " + str(int(gift.id))[-6:]

    def add(self, a, gift, owner, kind, replace=0):
            if gift is None:
                raise ValueError("Карточка ещё не загрузилась")
            owner = owner or self.uid(a)
            with self.lock:
                db = self.store(a)
                unique = isinstance(gift, TL_stars.TL_starGiftUnique)
                if local_id(gift.id):
                    raise ValueError("Это уже локальный подарок; копия не создаётся")
                original_slug = source_slug(gift) if unique else ""
                original_id = int(gift.id)
                key_source = "slug:" + original_slug.lower() if original_slug else ("id:" + str(original_id) if unique and original_id > 0 else "")
                # Purchased identities remain consumed after transfer/sale/deletion.
                if unique and kind in ("purchase", "copy", "edit") and (key_source in db["consumed"] or "id:" + str(original_id) in db["consumed"]):
                    raise ValueError("Этот NFT уже покупали. Дубликат не создаётся.")
                g = decode(encode(gift))
                price = 0
                amounts = field(g, "resell_amount")
                if amounts is not None and amounts.size():
                    item = amounts.get(0)
                    if "Ton" not in str(item.getClass().getSimpleName()):
                        price = max(0, int(item.amount))
                if not unique:
                    price = max(0, int(field(g, "stars", 0)))
                n = self.next_id(db)
                g.id = n
                if unique:
                    g.owner_id = peer(owner)
                    g.flags = (int(g.flags) | 1) & ~6
                    g.owner_name = None
                    g.owner_address = None
                    g.resell_amount = None
                    g.slug = "LocalGift-" + str(-n)
                row = {"id": n, "owner": owner, "data": encode(g), "date": int(time.time()),
                       "group": "", "hidden": False, "replace": int(replace), "source": original_id,
                       "label": self.label(g), "public_id": "FN-" + uuid.uuid4().hex[:16].upper(),
                       "source_slug": original_slug, "source_key": key_source, "custom": unique and not bool(original_slug),
                       "preview_only": False, "state": "owned" if owner == self.uid(a) else "transferred",
                       "price": 0, "purchase_price": price}
                db["gifts"].append(row)
                if key_source:
                    db["consumed"][key_source] = row["public_id"]
                    if original_id > 0:
                        db["consumed"]["id:" + str(original_id)] = row["public_id"]
                self.event(db, row, owner, kind, amount=price)
                self.save(a)
            self.refresh(a)
            self.info("Выдан: " + row["label"])
            if kind == "purchase":
                self.finish_purchase(a, row, db["events"][-1])
            return row

    def event(self, db, row, dialog, kind, amount=0):
            db["events"].append({"id": self.next_id(db), "gift": row["data"], "dialog": dialog,
                                 "date": int(time.time()), "kind": kind, "label": row["label"],
                                 "public_id": row["public_id"], "amount": int(amount)})

    def saved(self, row):
            g = TL_stars.TL_savedStarGift()
            g.flags = 8
            g.msg_id = int(row["id"])
            g.saved_id = int(row["id"])
            g.date = int(row["date"])
            g.gift = decode(row["data"])
            if row.get("state") == "listed" and isinstance(g.gift, TL_stars.TL_starGiftUnique):
                price = TL_stars.TL_starsAmount()
                price.amount = int(row.get("price", 0))
                g.gift.resell_amount = jclass("java.util.ArrayList")()
                g.gift.resell_amount.add(price)
            g.unsaved = bool(row["hidden"])
            g.can_upgrade = False
            g.pinned_to_top = bool(row.get("pinned", False))
            return g

    def matches(self, li, row):
            if bool(field(li, "isCollection", False)):
                return False
            if int(field(li, "craftingGiftId", 0)):
                return False
            unique = isinstance(decode(row["data"]), TL_stars.TL_starGiftUnique)
            try:
                if row["hidden"] and not li.isInclude_hidden():
                    return False
                if not row["hidden"] and not li.isInclude_displayed():
                    return False
                if unique and not li.isInclude_unique():
                    return False
            except Exception:
                pass
            return True

    def strip(self, li):
            for i in range(li.gifts.size() - 1, -1, -1):
                if local_id(li.gifts.get(i).gift.id):
                    li.gifts.remove(i)

    def inject(self, li):
            if li is None or not self.alive:
                return
            a = int(li.currentAccount)
            owner = int(li.dialogId) or self.uid(a)
            db = self.store(a)
            rows = [r for r in self.visible_records(a) if r["owner"] == owner and self.matches(li, r)]
            self.strip(li)
            hidden_ids = {r["replace"] for r in rows if r["replace"]}
            native = [li.gifts.get(i) for i in range(li.gifts.size())
                      if int(li.gifts.get(i).gift.id) not in hidden_ids]
            pinned = [g for g in native if bool(g.pinned_to_top)]
            rest = [g for g in native if not bool(g.pinned_to_top)]
            combined = pinned + [self.saved(r) for r in reversed(rows)] + rest
            order = db.get("profile_order", {}).get(str(owner), [])
            ranks = {int(gid): i for i, gid in enumerate(order)}
            # Reordering is local. A gift never jumps ahead of the pinned tier.
            combined.sort(key=lambda g: (0 if bool(g.pinned_to_top) else 1,
                                         ranks.get(int(g.gift.id), len(ranks))))
            li.gifts.clear()
            for gift in combined:
                li.gifts.add(gift)

    def got_list(self, p):
            li = p.getResult()
            if li is None:
                return
            if not any(x == li for x in self.lists):
                self.lists.append(li)
            self.inject(li)

    def fake_profile_key(self, a):
        return "fake_profile_v2_" + str(self.uid(a))

    def fake_profile(self, a):
        raw = self.get_setting(self.fake_profile_key(a), "")
        data = {"number": "", "main": "", "extra": [], "prices": {}, "last": {}}
        if raw:
            try:
                saved = json.loads(raw)
                if isinstance(saved, dict):
                    data.update(saved)
            except Exception:
                pass
        for key, default in (("extra", []), ("prices", {}), ("last", {})):
            if not isinstance(data.get(key), type(default)):
                data[key] = default
        return data

    def save_fake_profile(self, a, data):
        self.set_setting(self.fake_profile_key(a), json.dumps(data, ensure_ascii=False))
        self.apply_fake_profile_now(a)
        self.info("Fake Profile сохранён локально")

    def normalize_fake_username(self, value, allow_empty=True):
        value = str(value or "").strip()
        value = re.sub(r"^(?:https?://)?t\.me/", "", value, flags=re.I).strip("/@")
        if not value and allow_empty:
            return ""
        if not re.fullmatch(r"[A-Za-z0-9_]{1,32}", value):
            raise ValueError("Username: только A-Z, 0-9, _; максимум 32 символа")
        return value

    def fake_number_dialog(self, a):
        data = self.fake_profile(a)
        def save(v):
            value = str(v[0] or "").strip().replace(" ", "").replace("-", "")
            if value:
                if not value.startswith("+"):
                    value = "+" + value
                if not re.fullmatch(r"\+[0-9]{5,20}", value):
                    raise ValueError("Введи номер в формате +888123456789")
            data["number"] = value
            self.save_fake_profile(a, data)
        self.form("Fake Profile · Number",
                  [("Любой номер, например +888123456789", data.get("number", ""))], save)

    def fake_username_menu(self, a):
        data = self.fake_profile(a)
        main = data.get("main") or "оригинальный"
        extra = data.get("extra") or []
        subtitle = ("Основной: @" + main if main != "оригинальный" else "Основной: оригинальный")
        subtitle += "\nДополнительные: " + (", ".join("@" + x for x in extra) if extra else "нет")
        self.dialog(
            "Fake Profile · Username",
            subtitle,
            items=["Основной username", "Дополнительные username", "Цена / последняя покупка", "Сбросить Fake Profile"],
            action=lambda i:
                self.fake_main_username_dialog(a) if i == 0 else
                self.fake_extra_usernames_dialog(a) if i == 1 else
                self.fake_username_meta_dialog(a) if i == 2 else
                self.reset_fake_profile(a),
        )

    def fake_main_username_dialog(self, a):
        data = self.fake_profile(a)
        def save(v):
            data["main"] = self.normalize_fake_username(v[0], True)
            self.save_fake_profile(a, data)
        self.form("Основной username",
                  [("@username; пусто = оригинальный", data.get("main", ""))], save)

    def fake_extra_usernames_dialog(self, a):
        data = self.fake_profile(a)
        current = ", ".join(data.get("extra", []))
        def save(v):
            result = []
            for item in re.split(r"[\s,;]+", str(v[0] or "").strip()):
                if not item:
                    continue
                username = self.normalize_fake_username(item, False)
                if username not in result:
                    result.append(username)
            data["extra"] = result[:20]
            self.save_fake_profile(a, data)
        self.form("Дополнительные username",
                  [("Через запятую; пусто = убрать все", current)], save)

    def fake_username_meta_dialog(self, a):
        data = self.fake_profile(a)
        names = []
        if data.get("main"):
            names.append(data["main"])
        names += [x for x in data.get("extra", []) if x not in names]
        if not names:
            self.info("Сначала задай username")
            return

        def choose(i):
            username = names[i]
            price = str(data.get("prices", {}).get(username, ""))
            last = str(data.get("last", {}).get(username, ""))

            def save(v):
                price_value = str(v[0] or "").strip()
                last_value = str(v[1] or "").strip()

                if price_value:
                    if not re.fullmatch(r"[0-9]{1,18}(?:[.,][0-9]{1,6})?", price_value):
                        raise ValueError("Цена: только число")
                    data.setdefault("prices", {})[username] = price_value.replace(",", ".")
                else:
                    data.setdefault("prices", {}).pop(username, None)

                if last_value:
                    data.setdefault("last", {})[username] = last_value[:80]
                else:
                    data.setdefault("last", {}).pop(username, None)

                self.save_fake_profile(a, data)

            self.form(
                "@" + username,
                [
                    ("Цена; пусто = оставить оригинальную", price),
                    ("Последняя покупка; например 31.10.2026", last),
                ],
                save,
            )

        self.pages("Username", ["@" + x for x in names], choose)

    def reset_fake_profile(self, a):
        self.set_setting(self.fake_profile_key(a), "")
        self.apply_fake_profile_now(a)
        self.info("Fake Profile сброшен")

    def apply_fake_profile_to_user(self, a, user):
        if user is None:
            return user
        try:
            if int(field(user, "id", 0)) != self.uid(a):
                return user
        except Exception:
            return user

        data = self.fake_profile(a)
        number = str(data.get("number", "") or "")
        main = str(data.get("main", "") or "")
        extra = list(data.get("extra", []) or [])

        if number:
            try:
                user.phone = number.lstrip("+")
                user.flags = int(field(user, "flags", 0)) | 16
            except Exception:
                pass

        if main:
            try:
                user.username = main
                user.flags = int(field(user, "flags", 0)) | 8
            except Exception:
                pass

        if main or extra:
            try:
                ArrayList = jclass("java.util.ArrayList")
                usernames = ArrayList()
                seen = set()
                for index, name in enumerate(([main] if main else []) + extra):
                    if not name or name.casefold() in seen:
                        continue
                    seen.add(name.casefold())
                    item = TLRPC.TL_username()
                    item.username = name
                    item.active = True
                    item.editable = index == 0
                    usernames.add(item)
                user.usernames = usernames
            except Exception as e:
                self.error(e)

        return user

    def fake_profile_user(self, p):
        user = p.getResult()
        if user is None:
            return
        a = int(field(p.thisObject, "currentAccount", self.account()))
        self.apply_fake_profile_to_user(a, user)
        p.setResult(user)

    def apply_fake_profile_now(self, a):
        try:
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(a)
            user = mc.getUser(self.uid(a))
            self.apply_fake_profile_to_user(a, user)
            f = get_last_fragment()
            if f is not None and "ProfileActivity" in str(f.getClass().getSimpleName()):
                updater = getattr(f, "updateProfileData", None)
                if callable(updater):
                    updater()
        except Exception as e:
            self.error(e)

    def _profile_view_walk(self, view):
        if view is None:
            return
        yield view
        try:
            count = int(view.getChildCount())
        except Exception:
            return
        for i in range(count):
            child = view.getChildAt(i)
            for item in self._profile_view_walk(child):
                yield item

    def fake_profile_fragment(self, p):
        fragment = p.thisObject
        a = int(field(fragment, "currentAccount", self.account()))
        my_uid = self.uid(a)

        dialog_id = int(field(fragment, "dialog_id", field(fragment, "userId", 0)) or 0)
        if dialog_id not in (0, my_uid):
            return

        data = self.fake_profile(a)
        names = []
        if data.get("main"):
            names.append(data["main"])
        names += [x for x in data.get("extra", []) if x not in names]
        prices = data.get("prices", {})
        last = data.get("last", {})

        root = field(fragment, "fragmentView")
        if root is None:
            return

        uid_text = str(my_uid)
        creation_words = (
            "account created", "created on", "creation date", "account age",
            "дата создания", "аккаунт создан", "возраст аккаунта", "создан аккаунт",
        )

        for view in self._profile_view_walk(root):
            if not isinstance(view, TextView):
                continue
            try:
                current = str(view.getText() or "")
            except Exception:
                continue
            stripped = current.strip()
            lower = stripped.casefold()

            # Hide only local Extera/profile metadata. Never change the real Telegram ID.
            id_like = (
                stripped == uid_text
                or bool(re.fullmatch(r"(?i)(?:user\s*)?id\s*[:#]?\s*" + re.escape(uid_text), stripped))
            )
            created_like = len(stripped) <= 120 and any(word in lower for word in creation_words)

            if id_like or created_like:
                try:
                    parent = view.getParent()
                    if parent is not None:
                        parent.setVisibility(8)
                    else:
                        view.setVisibility(8)
                except Exception:
                    try:
                        view.setText("")
                    except Exception:
                        pass
                continue

            # Add/replace local collectible-username metadata on the row where username is shown.
            for username in names:
                marker = "@" + username.casefold()
                if marker not in lower and stripped.casefold() != username.casefold():
                    continue

                meta = []
                if username in prices:
                    meta.append("цена: " + str(prices[username]))
                if username in last:
                    meta.append("последняя покупка: " + str(last[username]))
                if not meta:
                    break

                base = re.sub(r"\s+•\s+(?:цена:|последняя покупка:).*$", "", stripped, flags=re.I)
                rendered = base + "  •  " + "  •  ".join(meta)
                if rendered != stripped:
                    try:
                        view.setText(rendered)
                    except Exception:
                        pass
                break


    def user_full(self, p):
            full = p.getResult()
            if full is None or not self.alive or not p.args:
                return
            a = int(field(p.thisObject, "currentAccount", self.account()))
            owner = int(p.args[0])
            extra = sum(1 for r in self.visible_records(a) if r["owner"] == owner and not r["hidden"] and not r["replace"])
            if not extra:
                return
            out = SerializedData()
            inp = None
            try:
                full.serializeToStream(out)
                inp = SerializedData(out.toByteArray())
                copy = TLRPC.UserFull.TLdeserialize(inp, inp.readInt32(True), True)
                copy.stargifts_count = int(full.stargifts_count) + extra
                p.setResult(copy)
            finally:
                out.cleanup()
                if inp is not None:
                    inp.cleanup()

    def before_load(self, p):
            # Remove overlays before native pagination computes its end condition.
            if not bool(p.thisObject.loading) and not bool(p.thisObject.endReached):
                self.strip(p.thisObject)

    def total(self, p):
            li = p.thisObject
            a = int(li.currentAccount)
            owner = int(li.dialogId) or self.uid(a)
            count = sum(1 for r in self.visible_records(a) if r["owner"] == owner and not r["replace"] and self.matches(li, r))
            from java.lang import Integer
            p.setResult(Integer(int(p.getResult()) + count))

    def notification(self, p):
            if len(p.args) == 2 and int(p.args[0]) == int(NotificationCenter.starUserGiftsLoaded):
                args = p.args[1]
                if len(args) > 1 and field(args[1], "gifts") is not None:
                    self.inject(args[1])

    def visible_records(self, a):
        return [r for r in self.store(a)["gifts"] if row_active(r)]

    def refresh(self, a):
        owners = {self.uid(a)} | {int(r["owner"]) for r in self.visible_records(a)}
        for li in list(self.lists):
            try:
                if int(li.currentAccount) == a:
                    self.inject(li)
                    li.notifyUpdate()
                    owners.add(int(li.dialogId))
            except Exception:
                pass

        from java.lang import Long
        mc = jclass("org.telegram.messenger.MessagesController").getInstance(a)
        for owner in owners:
            if owner > 0:
                try:
                    full = mc.getUserFull(owner)
                    if full is not None:
                        NotificationCenter.getInstance(a).postNotificationName(
                            NotificationCenter.userInfoDidLoad, Long(owner), full
                        )
                except Exception:
                    pass


    def row(self, a, gift):
            if gift is None:
                return None
            return next((r for r in self.store(a)["gifts"] if r["id"] == int(gift.id)), None)

    def buy_normal(self, p):
            if not self.mode():
                return
            p.setResult(None)  # Must precede all work: errors never fall through to a real purchase.
            a = int(field(p.thisObject, "currentAccount", self.account()))
            if len(p.args) != 6:
                self.info("Сигнатура покупки отличается; операция заблокирована.")
                return
            self.add(a, p.args[0], int(p.args[3]), "purchase")
            if p.args[5] is not None:
                p.args[5].run(True, None)

    def buy_unique(self, p):
            if not self.mode():
                return
            p.setResult(None)
            s = p.thisObject
            a = int(field(s, "currentAccount", self.account()))
            owner = int(field(s, "dialogId", 0)) if bool(field(s, "resale", False)) else self.uid(a)
            if local_id(s.getGift().id):
                self.info("Это уже локальный подарок")
                return
            self.add(a, s.getGift(), owner, "purchase")
            s.dismiss()

    def buy_resale(self, p):
            if not self.mode():
                return
            p.setResult(None)
            a = int(field(p.thisObject, "currentAccount", self.account()))
            if local_id(p.args[1].id):
                self.info("Повторная покупка недоступна")
                return
            self.add(a, p.args[1], int(p.args[2]), "purchase")
            cb = p.args[len(p.args) - 1]
            if cb is not None:
                cb.run(True, None)

    def open_transfer(self, p):
            sheet = p.thisObject
            a = int(field(sheet, "currentAccount", self.account()))
            row = self.row(a, sheet.getGift())
            if row is None and not self.mode():
                return
            p.setResult(None)
            if row is None:
                self.info("Сначала купи NFT в Fake-режиме")
                return
            if not trade_allowed(row, self.uid(a)):
                self.info("Передача недоступна для этого подарка")
                return
            def go(uid):
                self.move(a, row, uid)
                sheet.dismiss()
            self.recipient(a, go)

    def transfer_hook(self, p):
            sheet = p.thisObject
            a = int(field(sheet, "currentAccount", self.account()))
            row = self.row(a, sheet.getGift())
            if row is None and not self.mode():
                return
            p.setResult(None)
            if row is None:
                self.info("Сначала купи NFT в Fake-режиме")
                return
            self.move(a, row, int(p.args[0]))
            if len(p.args) > 1 and p.args[1] is not None:
                p.args[1].run(None)

    def move(self, a, row, owner):
            if not 0 < owner < 2**63:
                raise ValueError("Неверный ID получателя")
            if owner == self.uid(a):
                raise ValueError("Подарок уже у тебя")
            with self.lock:
                if not trade_allowed(row, self.uid(a)):
                    raise ValueError("Передача недоступна: Custom, чужой, проданный или выставленный подарок")
                g = decode(row["data"])
                g.owner_id = peer(owner)
                row.update(owner=owner, data=encode(g), replace=0, group="", state="transferred", price=0)
                self.event(self.store(a), row, owner, "transfer")
                self.save(a)
            self.refresh(a)
            self.info("Передано локально")
            self.finish_purchase(a, row, self.store(a)["events"][-1])

    def finish_purchase(self, a, row, event):
            from org.telegram.messenger import AndroidUtilities
            # Delay until the originating payment callback/sheet has finished.
            def finish():
                if not self.alive or a != self.account():
                    return
                try:
                    f = get_last_fragment()
                    if not f:
                        return
                    Chat = jclass("org.telegram.ui.ChatActivity")
                    target = int(event["dialog"])
                    def celebrate(chat):
                        try:
                            if chat is not None:
                                from java import jarray
                                from java.lang import Object, Long, Boolean, Integer
                                arr = jclass("java.util.ArrayList")()
                                messages = field(chat, "messages")
                                exists = messages is not None and any(int(messages.get(i).getId()) == int(event["id"]) for i in range(messages.size()))
                                if not exists:
                                    arr.add(self.message(a, event))
                                chat.didReceivedNotification(NotificationCenter.didReceiveNewMessages, a,
                                    jarray(Object)([Long(target), arr, Boolean(False), Integer(0)]))
                            if self.get_setting("celebrate", True):
                                launch = jclass("org.telegram.ui.LaunchActivity").instance
                                if launch and launch.getFireworksOverlay():
                                    launch.getFireworksOverlay().start(True)
                            gift = decode(row["data"])
                            doc = field(gift, "sticker")
                            if doc is None:
                                for i in range(gift.attributes.size()):
                                    attr = gift.attributes.get(i)
                                    if "AttributeModel" in str(attr.getClass().getSimpleName()):
                                        doc = attr.document
                                        break
                            if doc is not None:
                                factory = jclass("org.telegram.ui.Components.BulletinFactory").of(chat or f)
                                factory.createEmojiBulletin(doc, "Подарок продан" if event["kind"] == "sale" else "Подарок передан" if event["kind"] == "transfer" else "Подарок получен", row["label"]).show(True)
                        except Exception as e:
                            self.error(e)
                    if not self.get_setting("open_chat", True):
                        celebrate(None)
                    elif isinstance(f, Chat) and int(f.getDialogId()) == target:
                        celebrate(f)
                    else:
                        chat = Chat.of(target)
                        chat.whenFullyVisible(Run(lambda: celebrate(chat)))
                        f.presentFragment(chat)
                except Exception as e:
                    self.error(e)
                    self.info("Подарок сохранён; чат не открылся")
            AndroidUtilities.runOnUIThread(Run(finish), 350)

    def network_guard(self, p):
            if not p.args or p.args[0] is None:
                return
            req = p.args[0]
            name = str(req.getClass().getSimpleName()).lower()
            invoice = field(req, "invoice")
            invname = str(invoice.getClass().getSimpleName()).lower() if invoice else ""
            mutation = any(x in name for x in ("transferstargift", "savestargift", "upgradestargift", "convertstargift", "updatestargift", "toggle stargift", "craftstargift", "create stargift"))
            mutation = mutation or ("stargift" in name and any(x in name for x in ("create", "delete", "toggle", "reorder")))
            payment = "payment" in name and ("stargift" in name or "stargift" in invname or "send" in name)
            ref = field(req, "stargift")
            ref_local = ref is not None and (local_id(field(ref, "msg_id", 0)) or local_id(field(ref, "saved_id", 0)))
            slug_local = str(field(req, "slug", "") or "").startswith("LocalGift-")
            slug_local = slug_local or str(field(ref, "slug", "") or "").startswith("LocalGift-")
            slug_local = slug_local or str(field(invoice, "slug", "") or "").startswith(("LocalGift-", "spaceterna-"))
            ids = field(req, "id")
            message_local = False
            if any(x in name for x in ("forwardmessages", "deletemessages", "editmessage")):
                try:
                    message_local = any(local_id(ids.get(i)) for i in range(ids.size()))
                except Exception:
                    try:
                        message_local = local_id(ids)
                    except Exception:
                        pass
            if (self.mode() and (mutation or payment)) or ref_local or slug_local or message_local:
                from java.lang import Integer
                p.setResult(Integer(0))
                self.info("Локальная операция: запрос к Telegram не отправлен.")

    def on_send_message_hook(self, account, params):
            reply = field(params, "replyToMsg")
            if reply is not None and local_id(reply.getId()):
                self.info("На локальное событие нельзя отправить сетевой ответ.")
                return HookResult(strategy=HookStrategy.CANCEL)
            return HookResult()

    def message(self, a, event):
            g = decode(event["gift"])
            m = TLRPC.TL_messageService()
            m.id = int(event["id"])
            m.date = int(event["date"])
            m.dialog_id = int(event["dialog"])
            m.peer_id = peer(int(event["dialog"]))
            m.from_id = peer(self.uid(a))
            m.flags = 258
            m.out = True
            m.unread = False
            m.send_state = 0
            if isinstance(g, TL_stars.TL_starGiftUnique):
                act = TLRPC.TL_messageActionStarGiftUnique()
            else:
                act = TLRPC.TL_messageActionStarGift()
            act.gift = g
            act.saved = True
            act.transferred = event["kind"] == "transfer"
            if event["kind"] == "sale" and isinstance(g, TL_stars.TL_starGiftUnique):
                amount = TL_stars.TL_starsAmount()
                amount.amount = int(event.get("amount", 0))
                try:
                    act.resale_amount = amount
                    act.from_offer = True
                except Exception:
                    act.resale_stars = amount.amount
            act.flags = 4 | ((2 if isinstance(g, TL_stars.TL_starGiftUnique) else 64) if act.transferred else 0)
            m.action = act
            return MessageObject(a, m, True, False)

    def chat_notification(self, p):
            if len(p.args) != 3 or int(p.args[0]) != int(NotificationCenter.messagesDidLoad):
                return
            a = int(p.args[1])
            args = p.args[2]
            if len(args) < 15 or int(args[14]) != 0:
                return
            chat = p.thisObject
            if int(args[10]) != int(field(chat, "classGuid", -1)):
                return
            dialog = int(field(chat, "dialog_id", 0))
            if dialog <= 0 or int(field(chat, "threadMessageId", 0)) != 0:
                return
            arr = args[2]
            # Inject only into newest/initial loads, never into historical pagination.
            if int(args[8]) not in (0, 2) or int(args[4]) != 0:
                return
            events = [e for e in self.store(a)["events"] if e["dialog"] == dialog and e["kind"] in ("purchase", "transfer", "sale")]
            existing = {int(arr.get(i).getId()) for i in range(arr.size())}
            if not bool(field(chat, "clearOnLoad", False)):
                loaded = field(chat, "messages")
                if loaded is not None:
                    existing.update(int(loaded.get(i).getId()) for i in range(loaded.size()))
            for event in events:
                if event["id"] in existing:
                    continue
                obj = self.message(a, event)
                pos = 0
                while pos < arr.size() and int(arr.get(pos).messageOwner.date) > event["date"]:
                    pos += 1
                arr.add(pos, obj)
                existing.add(event["id"])

    def on_plugin_unload(self):
        self.alive = False
        self.ready = False
        lists = list(self.lists)

        def clean():
            for li in lists:
                try:
                    self.strip(li)
                    li.invalidate(True)
                except Exception:
                    pass

        run_on_ui_thread(clean)
